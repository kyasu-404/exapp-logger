<?xml version="1.0"?>
<info>
	<id>file_control</id>
	<name>Сбор и контроль файлов</name>
	<summary>Контроль централизованного сбора файлов от организаций</summary>
	<description><![CDATA[
		ExApp фиксирует поступление, обновление, перемещение и удаление файлов в папках кампаний,
		показывает ход сдачи и формирует отчёты XLSX/CSV.
	]]></description>
	<version>1.0.0</version>
	<licence>agpl</licence>
	<author>ExApp File Control contributors</author>
	<namespace>FileControl</namespace>
	<category>tools</category>
	<dependencies>
		<nextcloud min-version="32" max-version="36"/>
	</dependencies>
	<external-app>
		<docker-install>
			<registry>ghcr.io</registry>
			<image>kyasu-404/file-control</image>
			<image-tag>1.0.0</image-tag>
		</docker-install>
		<routes>
			<route>
				<url>^/api/events/nextcloud$</url>
				<verb>POST</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/api/.*$</url>
				<verb>GET,POST,PUT,PATCH,DELETE</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/(js|css|img)/.*</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
		</routes>
		<environment-variables>
			<variable>
				<name>DATABASE_URL</name>
			</variable>
			<variable>
				<name>LOG_LEVEL</name>
				<default>INFO</default>
			</variable>
			<variable>
				<name>DEBUG</name>
				<default>false</default>
			</variable>
			<variable>
				<name>RECONCILE_INTERVAL_MINUTES</name>
				<default>45</default>
			</variable>
			<variable>
				<name>ADMIN_GROUPS</name>
				<default>admin,file_control_admins</default>
			</variable>
			<variable>
				<name>OBSERVER_GROUPS</name>
				<default>file_control_observers</default>
			</variable>
			<variable>
				<name>MAX_UPLOAD_MB</name>
				<default>20</default>
			</variable>
		</environment-variables>
	</external-app>
</info>
